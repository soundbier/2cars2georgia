rules_version = '2';

// Zugriffsmodell: Persönliche Firebase-Auth-Konten (E-Mail/Passwort oder
// Google, siehe src/lib/authAccount.ts) – jede Person hat eine eigene,
// echte UID (request.auth.uid). Ein Roadtrip ist kein technischer Auth-User
// mehr, sondern ein Dokument unter roadtrips/{tripId} mit einer
// Mitgliedschafts-Collection roadtrips/{tripId}/members/{uid} (siehe
// src/lib/membership.ts): Lesen/Schreiben ist nur erlaubt, wer dort ein
// Mitgliedschafts-Dokument hat, und die dort gespeicherte Rolle (owner /
// member / readonly, siehe src/lib/permissions.ts) bestimmt, was erlaubt
// ist – nicht die Oberfläche.
//
// Zusätzlich gibt es users/{uid} (Profil: Anzeigename, E-Mail,
// Erstellungsdatum) und usernames/{normalizedName} (Reservierung für
// eindeutige Anzeigenamen, siehe src/lib/username.ts).
//
// Zusätzlich validiert jede Collection ihre Dokumente wie zuvor: erlaubte
// Felder, Datentypen, maximale Längen, Wertebereiche. Diese Prüfungen sind
// unverändert aus der vorherigen Fassung übernommen.
//
// Bewusst gibt es KEINEN rekursiven Wildcard mehr unterhalb eines Roadtrips:
// Jede Collection ist einzeln aufgeführt. Eine neue Collection braucht damit
// eine bewusste Regeländerung, statt still durch eine Sammelfreigabe zu
// rutschen. Die Regeln sind in tests/rules/firestore.rules.test.ts abgedeckt.
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Bausteine für die Feldprüfung ----------------------------------

    // Bei create wie bei update enthält request.resource.data das vollständige
    // Dokument NACH dem Schreibvorgang – dieselben Prüfungen gelten deshalb
    // für beides, auch wenn die App bei update nur einzelne Felder schickt.
    function data() {
      return request.resource.data;
    }

    function fieldsAre(required, optional) {
      return data().keys().hasAll(required) && data().keys().hasOnly(required.concat(optional));
    }

    function isText(field, maxLength) {
      return data()[field] is string
        && data()[field].size() > 0
        && data()[field].size() <= maxLength;
    }

    function isOptionalText(field, maxLength) {
      return !(field in data()) || (data()[field] is string && data()[field].size() <= maxLength);
    }

    // Zeitstempel kommen aus Date.now() im Client. Eine exakte Serverzeit lässt
    // sich nicht verlangen, da Einträge offline entstehen und später
    // nachsynchronisiert werden – geprüft wird nur eine plausible Größenordnung.
    function isEpochMillis(field) {
      return data()[field] is int && data()[field] > 1000000000000 && data()[field] < 4000000000000;
    }

    // Papierkorb-Markierung (siehe src/lib/trash.ts): fehlt bei aktiven
    // Einträgen komplett und trägt beim Löschen die Client-Zeit.
    function isOptionalEpochMillis(field) {
      return !(field in data()) || isEpochMillis(field);
    }

    function isLatitude(field) {
      return data()[field] is number && data()[field] >= -90 && data()[field] <= 90;
    }

    function isLongitude(field) {
      return data()[field] is number && data()[field] >= -180 && data()[field] <= 180;
    }

    // Kalendertag als 'YYYY-MM-DD', z.B. Reisezeitraum oder Speiseplan-Tag.
    function isDateString(field) {
      return data()[field] is string && data()[field].matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isOptionalDateString(field) {
      return !(field in data()) || isDateString(field);
    }

    function isMealType() {
      return data().mealType in ['breakfast', 'lunch', 'dinner'];
    }

    function isQuantity(field) {
      return data()[field] is number && data()[field] >= 0 && data()[field] <= 100000;
    }

    // Optionales authorId (echte UID statt Anzeigename) – ergänzend zu
    // `author`, siehe src/types.ts. Wo gesetzt, muss es der eigenen UID
    // entsprechen: sonst könnte ein Mitglied Einträge im Namen einer anderen
    // Person erzeugen.
    function isOptionalAuthorId() {
      return !('authorId' in data()) || data().authorId == request.auth.uid;
    }

    // --- Identität: Profile & eindeutige Anzeigenamen --------------------

    function signedIn() {
      return request.auth != null;
    }

    // Bestätigte E-Mail-Adresse (Firebase setzt email_verified im Token,
    // sobald der Link aus sendEmailVerification() angeklickt wurde; bei
    // Google-Anmeldung ist er von Haus aus true).
    //
    // Bewusst nur dort verlangt, wo eine NEUE Mitgliedschaft entsteht
    // (roadtrips create + members create): Bestehende Mitglieder – auch das
    // Administrationskonto aus der Zeit vor dieser Prüfung – arbeiten
    // unverändert weiter, nichts wird nachträglich gesperrt oder muss neu
    // angelegt werden. `get(..., false)` statt direktem Feldzugriff, weil
    // das Feld in fremd erzeugten Tokens fehlen kann.
    function emailVerified() {
      return signedIn() && request.auth.token.get('email_verified', false) == true;
    }

    // Plattform-Administration: eine einzelne Person, die in ihrem eigenen
    // Profil users/{uid} das Feld `role: "admin"` trägt. Die Rolle wird
    // bewusst nirgends vom Client geschrieben (users/ erlaubt kein update
    // und beim create kein role-Feld) – sie wird einmalig direkt in der
    // Firebase-Konsole gesetzt. Sie erlaubt ausschließlich Lesen zur
    // Übersicht (siehe src/pages/Administration.tsx), keinerlei Schreiben.
    function isPlatformAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    // usernames/{normalizedName}: reserviert einen Anzeigenamen für genau
    // eine UID. Wird immer gemeinsam mit users/{uid} in derselben
    // Transaktion angelegt (siehe src/lib/username.ts) – beide oder keins.
    match /usernames/{normalizedName} {
      allow read: if signedIn();
      allow create: if signedIn()
        && fieldsAre(['uid', 'createdAt'], [])
        && data().uid == request.auth.uid
        && data().createdAt == request.time;
      // Kein Umbenennen/Freigeben: ein einmal vergebener Anzeigename bleibt
      // reserviert, auch wenn users/{uid} nie geschrieben würde.
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && fieldsAre(['displayName', 'email', 'createdAt'], [])
        && isText('displayName', 60)
        && data().email == request.auth.token.email
        && data().createdAt == request.time;
      // Kein Umbenennen: der Anzeigename ist über usernames/ reserviert,
      // eine Änderung hier würde die Reservierung veraisen lassen.
      allow update, delete: if false;
    }

    // --- Roadtrip-Wurzel -------------------------------------------------

    match /roadtrips/{tripId} {
      // Mitglied dieses Roadtrips? Die Rolle steht direkt am
      // Mitgliedschafts-Dokument – kein impliziter Fallback mehr wie früher
      // in lib/permissions.ts (getEffectiveRole), jede Rolle ist explizit.
      function isMember() {
        return signedIn()
          && exists(/databases/$(database)/documents/roadtrips/$(tripId)/members/$(request.auth.uid));
      }

      function myRole() {
        return get(/databases/$(database)/documents/roadtrips/$(tripId)/members/$(request.auth.uid)).data.role;
      }

      function isOwner() {
        return isMember() && myRole() == 'owner';
      }

      // Owner + member dürfen anlegen/ändern, readonly nur lesen.
      function canWrite() {
        return isMember() && myRole() != 'readonly';
      }

      // Anlegen: jede angemeldete Person mit Profil darf einen neuen
      // Roadtrip anlegen und wird dabei automatisch dessen Owner (siehe
      // src/lib/membership.ts – die Owner-Mitgliedschaft entsteht in einem
      // zweiten, separaten Schreibvorgang direkt danach).
      allow create: if signedIn()
        && emailVerified()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && fieldsAre(['name', 'createdAt', 'ownerUid'], [])
        && isText('name', 80)
        && data().ownerUid == request.auth.uid
        && data().createdAt == request.time;

      // Einzeldokument statt Liste: Vor dem Beitreten (createRoadtrip prüft
      // per get() auf freie Slugs, joinRoadtrip auf Existenz der Trip-ID,
      // siehe src/lib/membership.ts) ist die aufrufende Person noch kein
      // Mitglied – ein `read`, das komplett an isMember() hängt, würde genau
      // diese Prüfung selbst blockieren. Die Trip-ID dient ohnehin als
      // Beitritts-Code (siehe RoadtripGate) und ihr Inhalt ist unkritisch;
      // eine Auflistung fremder Roadtrips bleibt aber gesperrt.
      allow get: if signedIn();
      // Auflisten bleibt Mitgliedern vorbehalten; zusätzlich darf die
      // Plattform-Administration alle Roadtrips sehen (nur lesen).
      allow list: if isMember() || isPlatformAdmin();

      // Name/Erstellungsdatum/Owner eines Roadtrips ändern sich nach dem Anlegen nicht.
      allow update: if false;

      // Löschen: der Owner darf den Roadtrip endgültig löschen (siehe
      // src/lib/membership.ts, deleteRoadtripCascade – die Untercollections
      // werden dort einzeln geleert, da es keine serverseitige Kaskade ohne
      // Cloud Functions gibt). Zusätzlich: Aufräumen eines halb angelegten
      // Roadtrips, bei dem der zweite Schritt (Owner-Mitgliedschaft
      // anlegen) fehlgeschlagen ist – nur die Person, die ihn angelegt hat,
      // und nur solange sie selbst kein Mitglied ist.
      allow delete: if isOwner()
        || (signedIn() && resource.data.ownerUid == request.auth.uid && !isMember());

      // --- Mitgliedschaften ------------------------------------------------
      match /members/{memberUid} {
        // Beitreten: jede angemeldete Person trägt sich selbst als normales
        // Mitglied ein (siehe src/lib/membership.ts, joinRoadtrip). Wer den
        // Roadtrip anlegt, wird stattdessen Owner – nur zulässig, wenn die
        // aufrufende Person laut roadtrips/{tripId}.ownerUid tatsächlich die
        // Person ist, die ihn gerade angelegt hat.
        // Beitreten setzt eine bestätigte E-Mail-Adresse voraus – ein frisch
        // registriertes, unbestätigtes Konto kommt hier nicht durch (siehe
        // emailVerified() oben und src/lib/authAccount.ts).
        allow create: if signedIn()
          && emailVerified()
          && request.auth.uid == memberUid
          && fieldsAre(['displayName', 'role', 'joinedAt'], [])
          && isText('displayName', 60)
          && data().joinedAt == request.time
          && (
            data().role == 'member'
            || (data().role == 'owner'
                && get(/databases/$(database)/documents/roadtrips/$(tripId)).data.ownerUid == request.auth.uid)
          );

        // Gleiches Henne-Ei-Problem wie oben: joinRoadtrip prüft per get()
        // die eigene (noch nicht existierende) Mitgliedschaft, bevor sie
        // angelegt wird. `get` erlaubt deshalb zusätzlich den Blick auf das
        // eigene Dokument unabhängig vom Mitgliedsstatus – fremde
        // Mitgliedsdaten bleiben, wie zuvor, nur für Mitglieder sichtbar.
        allow get: if isMember() || isPlatformAdmin() || (signedIn() && request.auth.uid == memberUid);
        allow list: if isMember() || isPlatformAdmin();

        // Rolle ändern: nur der Owner, und nur die Rolle selbst – Name und
        // Beitrittsdatum bleiben unangetastet.
        allow update: if isOwner()
          && fieldsAre(['displayName', 'role', 'joinedAt'], [])
          && data().role in ['owner', 'member', 'readonly']
          && data().displayName == resource.data.displayName
          && data().joinedAt == resource.data.joinedAt;

        // Entfernen: der Owner darf jedes Mitglied entfernen, jede Person
        // darf sich selbst entfernen (den Roadtrip verlassen). Es gibt
        // bewusst keine serverseitige "letzter Owner"-Sperre – das wäre eine
        // Zählung über die ganze Collection, die Firestore-Regeln nicht
        // leisten; die Oberfläche warnt davor (siehe lib/permissions.ts,
        // countOwners).
        allow delete: if (isOwner() && request.auth.uid != memberUid) || request.auth.uid == memberUid;
      }

      // --- GPS-Spur ------------------------------------------------------
      // Die mit Abstand größte Collection: Bei kurzem Aufzeichnungsintervall
      // entstehen tausende Punkte pro Tour. Entsprechend eng ist die Prüfung.
      match /track/{pointId} {
        function isTrackPoint() {
          return fieldsAre(['timestamp', 'author', 'lat', 'lng', 'speedKmh', 'headingDeg'], ['authorId'])
            && isEpochMillis('timestamp')
            && isText('author', 60)
            && isOptionalAuthorId()
            && isLatitude('lat')
            && isLongitude('lng')
            && data().speedKmh is number
            && data().speedKmh >= 0
            && data().speedKmh <= 500
            // Kurs unbekannt (Stillstand, Gerät ohne Kompass) wird als null
            // gespeichert, siehe LivePosition in src/types.ts.
            && (data().headingDeg == null
                || (data().headingDeg is number && data().headingDeg >= 0 && data().headingDeg <= 360));
        }

        allow read: if isMember();
        allow create: if canWrite() && isTrackPoint();
        // Trackpunkte werden nur angehängt, nie nachträglich verändert.
        allow update: if false;
        allow delete: if isOwner();
      }

      // --- Logbuch -------------------------------------------------------
      match /events/{eventId} {
        function isLogEvent() {
          return fieldsAre(['timestamp', 'author', 'type', 'title', 'lat', 'lng'], ['note', 'deletedAt', 'authorId'])
            && isEpochMillis('timestamp')
            && isText('author', 60)
            && isOptionalAuthorId()
            && isText('type', 40)
            && isText('title', 120)
            && isOptionalText('note', 2000)
            && isOptionalEpochMillis('deletedAt')
            && isLatitude('lat')
            && isLongitude('lng');
        }

        allow read: if isMember();
        // Der Papierkorb (deletedAt) ist der Weg für die Crew; endgültig
        // entfernen darf nur der Owner.
        allow create, update: if canWrite() && isLogEvent();
        allow delete: if isOwner();
      }

      // --- Bordkasse -----------------------------------------------------
      match /expenses/{expenseId} {
        function isExpense() {
          return fieldsAre(
            ['timestamp', 'author', 'paidBy', 'title', 'amountEuro', 'category'],
            ['deletedAt', 'authorId'])
            && isOptionalEpochMillis('deletedAt')
            && isEpochMillis('timestamp')
            && isText('author', 60)
            && isOptionalAuthorId()
            && isText('paidBy', 60)
            && isText('title', 120)
            && data().amountEuro is number
            && data().amountEuro >= 0
            && data().amountEuro <= 1000000
            && isText('category', 40);
        }

        allow read: if isMember();
        allow create, update: if canWrite() && isExpense();
        allow delete: if isOwner();
      }

      // --- Kombüse: Gerichte -----------------------------------------------
      // Zutaten sind ein eingebettetes Array (siehe src/types.ts, Ingredient) –
      // Firestore-Regeln können den Inhalt eines Array-of-Maps nicht tief je
      // Element validieren, deshalb bleibt es bei Listenart und -länge. Das
      // ist konsistent mit dem übrigen Vertrauensmodell dieser Datei: Wer
      // Mitglied ist, ist vertraute Crew.
      match /dishes/{dishId} {
        function isDish() {
          return fieldsAre(
            ['name', 'mealType', 'ingredients', 'author', 'timestamp'],
            ['note', 'deletedAt', 'authorId'])
            && isText('name', 120)
            && isMealType()
            && data().ingredients is list
            && data().ingredients.size() <= 30
            && isText('author', 60)
            && isOptionalAuthorId()
            && isEpochMillis('timestamp')
            && isOptionalText('note', 500)
            && isOptionalEpochMillis('deletedAt');
        }

        allow read: if isMember();
        allow create, update: if canWrite() && isDish();
        allow delete: if isOwner();
      }

      // --- Kombüse: Speiseplan ----------------------------------------------
      // Ordnet ein Gericht einem Kalendertag und einer Mahlzeit zu. Mehrere
      // Einträge pro Tag+Mahlzeit sind erlaubt (mehrere Optionen zur Auswahl).
      match /mealPlanEntries/{entryId} {
        function isMealPlanEntry() {
          return fieldsAre(['date', 'mealType', 'dishId', 'author', 'timestamp'], ['deletedAt', 'authorId'])
            && isDateString('date')
            && isMealType()
            && isText('dishId', 64)
            && isText('author', 60)
            && isOptionalAuthorId()
            && isEpochMillis('timestamp')
            && isOptionalEpochMillis('deletedAt');
        }

        allow read: if isMember();
        allow create, update: if canWrite() && isMealPlanEntry();
        allow delete: if isOwner();
      }

      // --- Kombüse: Lager ----------------------------------------------------
      // Die Menge wird laufend angepasst (siehe src/pages/kombuese/Inventory.tsx) –
      // das ist ein gewöhnliches update, keine Sonderregel nötig.
      match /inventory/{itemId} {
        function isInventoryItem() {
          return fieldsAre(
            ['name', 'quantity', 'unit', 'location', 'author', 'timestamp'],
            ['deletedAt', 'authorId'])
            && isText('name', 80)
            && isQuantity('quantity')
            && isText('unit', 20)
            && isText('location', 60)
            && isText('author', 60)
            && isOptionalAuthorId()
            && isEpochMillis('timestamp')
            && isOptionalEpochMillis('deletedAt');
        }

        allow read: if isMember();
        allow create, update: if canWrite() && isInventoryItem();
        allow delete: if isOwner();
      }

      // --- Kombüse: Einkaufsliste (manuelle Posten) ---------------------------
      // Posten ohne Bezug zu einem Rezept, z.B. Gas oder Müllbeutel – der
      // Abhak-Status liegt hier direkt am Dokument, anders als bei den aus dem
      // Speiseplan berechneten Zeilen (siehe shoppingListChecks unten).
      match /shoppingListExtras/{itemId} {
        function isShoppingListExtra() {
          return fieldsAre(
            ['name', 'quantity', 'unit', 'checked', 'author', 'timestamp'],
            ['deletedAt', 'authorId'])
            && isText('name', 80)
            && isQuantity('quantity')
            && isText('unit', 20)
            && data().checked is bool
            && isText('author', 60)
            && isOptionalAuthorId()
            && isEpochMillis('timestamp')
            && isOptionalEpochMillis('deletedAt');
        }

        allow read: if isMember();
        allow create, update: if canWrite() && isShoppingListExtra();
        allow delete: if isOwner();
      }

      // --- Kombüse: Einkaufsliste (Abhaken berechneter Posten) ----------------
      // Für aus dem Speiseplan berechnete Zeilen (siehe src/lib/shoppingList.ts)
      // gibt es kein eigenes Dokument – der Abhak-Status liegt unter einem aus
      // Name+Einheit normalisierten Schlüssel. Rein reversibles Abhaken, daher
      // ohne Owner-Schranke; ein delete ist nur für das Aufräumen beim
      // Roadtrip-Löschen nötig (siehe lib/membership.ts).
      match /shoppingListChecks/{checkKey} {
        function isShoppingListCheck() {
          return fieldsAre(['checked', 'checkedBy', 'checkedAt'], [])
            && data().checked is bool
            && isText('checkedBy', 60)
            && isEpochMillis('checkedAt');
        }

        allow read: if isMember();
        allow create, update: if canWrite() && isShoppingListCheck();
        allow delete: if isOwner();
      }

      // --- Routenplaner: geplante Tagesrouten --------------------------------
      // Von Hand abgesteckte Routen (siehe src/hooks/usePlannedRoutes.ts).
      // Bewusst ohne Papierkorb: Eine geplante Route ist Vorbereitung, kein
      // Protokoll – und bewusst ohne Owner-Schranke beim Löschen, damit die
      // Crew ihre Tagesplanung selbst aufräumen kann. Welche Route aktiv ist,
      // steht gar nicht hier, sondern gerätelokal (src/lib/plannedRoute.ts).
      match /plannedRoutes/{routeId} {
        function isPlannedRoute() {
          return fieldsAre(['waypoints', 'updatedAt'], ['name', 'date', 'author', 'authorId'])
            && data().waypoints is list
            && data().waypoints.size() <= 500
            && isEpochMillis('updatedAt')
            && isOptionalText('name', 120)
            // Anders als beim Speiseplan darf der Tag fehlen oder leer sein:
            // Routen ohne festes Datum sind ausdrücklich vorgesehen.
            && (!('date' in data()) || data().date == '' || isDateString('date'))
            && isOptionalText('author', 60)
            && isOptionalAuthorId();
        }

        allow read: if isMember();
        allow create, update: if canWrite() && isPlannedRoute();
        allow delete: if canWrite();
      }

      // --- Roadtrip-weite Einstellungen ------------------------------------
      // Genau zwei Dokumente: "general" (Reisezeitraum) und "quicklogs"
      // (Schnell-Log-Kategorien), siehe src/hooks/useSettings.ts. Die Crew
      // (frühere Felder "users"/"roles") lebt jetzt in members/ – bleibt hier
      // als optionales, unverändertes Altfeld zugelassen, damit bereits
      // bestehende Dokumente nicht an der Feldprüfung scheitern.
      match /settings/{docId} {
        function isLegacyUsersList() {
          return !('users' in data()) || (data().users is list && data().users.size() <= 50);
        }

        function isLegacyRolesMap() {
          return !('roles' in data())
            || (data().roles is map
                && data().roles.size() <= 50
                && data().roles.values().hasOnly(['owner', 'member', 'readonly']));
        }

        function isSettingsDoc() {
          return (docId == 'general'
                  && fieldsAre([], ['users', 'roles', 'startDate', 'endDate'])
                  && isLegacyUsersList()
                  && isLegacyRolesMap()
                  // Reisezeitraum, gebraucht vom Kombüse-Speiseplan und der
                  // Tagesanzeige im Cockpit.
                  && isOptionalDateString('startDate')
                  && isOptionalDateString('endDate'))
              || (docId == 'quicklogs'
                  && fieldsAre(['items'], [])
                  && data().items is list
                  && data().items.size() <= 50);
        }

        allow read: if isMember();
        // Reisezeitraum ist Roadtrip-Konfiguration: nur der Owner legt sie an
        // oder ändert sie. Die Schnell-Log-Kategorien bleiben für die ganze
        // Crew offen.
        allow create, update: if isSettingsDoc()
          && ((docId == 'general' && isOwner()) || (docId == 'quicklogs' && canWrite()));
        allow delete: if isOwner();
      }

      // --- Fehlerprotokoll -------------------------------------------------
      // Von src/lib/errorLog.ts befüllt, damit Abstürze auf den Geräten der
      // Crew nachvollziehbar sind. Nur anhängen, nie ändern.
      match /errors/{errorId} {
        function isErrorEntry() {
          return fieldsAre(['timestamp', 'message'],
                           ['stack', 'context', 'author', 'authorId', 'appVersion', 'userAgent', 'url'])
            && isEpochMillis('timestamp')
            && isText('message', 1000)
            && isOptionalText('stack', 4000)
            && isOptionalText('context', 200)
            && isOptionalText('author', 60)
            && isOptionalAuthorId()
            && isOptionalText('appVersion', 40)
            && isOptionalText('userAgent', 500)
            && isOptionalText('url', 500);
        }

        allow read: if isMember();
        allow create: if isMember() && isErrorEntry();
        allow update: if false;
        allow delete: if isOwner();
      }
    }

    // Alles außerhalb der oben aufgeführten Pfade ist gesperrt – Firestore
    // verweigert ohne passende allow-Regel ohnehin jeden Zugriff.
  }
}
