rules_version = '2';

// Zugriffsmodell: Pro Roadtrip existiert ein technischer Firebase-Auth-User
// (E-Mail "<roadtrip-id>@2cars2georgia.trip", Passwort = Roadtrip-Passwort,
// siehe src/lib/roadtrip.ts). Lesen/Schreiben unter roadtrips/{tripId}/...
// ist nur erlaubt, wenn der angemeldete Auth-User zu genau diesem tripId
// gehört – das UI-Passwort-Gate allein wäre kein echter Schutz, da jeder mit
// der Firebase-Config direkt gegen Firestore schreiben könnte.
//
// Zusätzlich validiert jede Collection ihre Dokumente. Wer das gemeinsame
// Roadtrip-Passwort kennt, darf zwar schreiben – aber nicht beliebig viel und
// nicht in beliebiger Form. Ohne diese Schranken könnte ein einzelnes Gerät
// (oder ein Skript mit dem Passwort) die Datenbank mit Müll fluten und damit
// echte Kosten verursachen.
//
// Bewusst gibt es KEINEN rekursiven Wildcard mehr unterhalb eines Roadtrips:
// Jede Collection ist einzeln aufgeführt. Eine neue Collection braucht damit
// eine bewusste Regeländerung, statt still durch eine Sammelfreigabe zu
// rutschen. Die Regeln sind in tests/rules/firestore.rules.test.ts abgedeckt.
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Identität ------------------------------------------------------

    function signedIn() {
      return request.auth != null && request.auth.token.email is string;
    }

    function signedInTripId() {
      return request.auth.token.email.split('@')[0];
    }

    function ownsTrip(tripId) {
      return signedIn() && signedInTripId() == tripId;
    }

    // Adminsitzung: derselbe Roadtrip, aber über den Admin-Zugang angemeldet
    // (eigener Auth-User "<tripId>@2cars2georgia.admin" mit eigenem Passwort,
    // siehe src/lib/roadtrip.ts). Die Rollen in settings/general taugen dafür
    // nicht – die kann jedes Gerät mit dem Roadtrip-Passwort selbst
    // umschreiben, die E-Mail der Sitzung dagegen nicht.
    //
    // Adminpflichtig ist bewusst nur, was sich nicht rückgängig machen lässt
    // oder die Crew umbaut: endgültiges Löschen und das Verwalten von
    // Mitgliedern/Rollen. Der Alltag (Einträge anlegen, ändern, in den
    // Papierkorb legen) bleibt für die ganze Crew offen.
    function isAdminSession(tripId) {
      return ownsTrip(tripId) && request.auth.token.email.matches('.*@2cars2georgia[.]admin');
    }

    // --- Bausteine für die Feldprüfung ----------------------------------

    // Bei create wie bei update enthält request.resource.data das vollständige
    // Dokument NACH dem Schreibvorgang – dieselben Prüfungen gelten deshalb
    // für beides, auch wenn die App bei update nur einzelne Felder schickt.
    function data() {
      return request.resource.data;
    }

    function fieldsAre(required, optional) {
      return data().keys().hasAll(required) && data().keys().hasOnly(required.concat(optional));
    }

    function isText(field, maxLength) {
      return data()[field] is string
        && data()[field].size() > 0
        && data()[field].size() <= maxLength;
    }

    function isOptionalText(field, maxLength) {
      return !(field in data()) || (data()[field] is string && data()[field].size() <= maxLength);
    }

    // Zeitstempel kommen aus Date.now() im Client. Eine exakte Serverzeit lässt
    // sich nicht verlangen, da Einträge offline entstehen und später
    // nachsynchronisiert werden – geprüft wird nur eine plausible Größenordnung.
    function isEpochMillis(field) {
      return data()[field] is int && data()[field] > 1000000000000 && data()[field] < 4000000000000;
    }

    // Papierkorb-Markierung (siehe src/lib/trash.ts): fehlt bei aktiven
    // Einträgen komplett und trägt beim Löschen die Client-Zeit.
    function isOptionalEpochMillis(field) {
      return !(field in data()) || isEpochMillis(field);
    }

    function isLatitude(field) {
      return data()[field] is number && data()[field] >= -90 && data()[field] <= 90;
    }

    function isLongitude(field) {
      return data()[field] is number && data()[field] >= -180 && data()[field] <= 180;
    }

    // Kalendertag als 'YYYY-MM-DD', z.B. Reisezeitraum oder Speiseplan-Tag.
    function isDateString(field) {
      return data()[field] is string && data()[field].matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isOptionalDateString(field) {
      return !(field in data()) || isDateString(field);
    }

    function isMealType() {
      return data().mealType in ['breakfast', 'lunch', 'dinner'];
    }

    function isQuantity(field) {
      return data()[field] is number && data()[field] >= 0 && data()[field] <= 100000;
    }

    // --- Roadtrip-Wurzel -------------------------------------------------

    match /roadtrips/{tripId} {
      // Anlegen passiert direkt nach createUserWithEmailAndPassword, der neue
      // Auth-User ist zu dem Zeitpunkt bereits angemeldet.
      allow create: if ownsTrip(tripId)
        && fieldsAre(['name', 'createdAt'], [])
        && isText('name', 80)
        && data().createdAt == request.time;

      allow read: if ownsTrip(tripId);

      // Name/Erstellungsdatum eines Roadtrips ändern sich nach dem Anlegen nicht.
      allow update, delete: if false;

      // --- GPS-Spur ------------------------------------------------------
      // Die mit Abstand größte Collection: Bei kurzem Aufzeichnungsintervall
      // entstehen tausende Punkte pro Tour. Entsprechend eng ist die Prüfung.
      match /track/{pointId} {
        function isTrackPoint() {
          return fieldsAre(['timestamp', 'author', 'lat', 'lng', 'speedKmh', 'headingDeg'], [])
            && isEpochMillis('timestamp')
            && isText('author', 60)
            && isLatitude('lat')
            && isLongitude('lng')
            && data().speedKmh is number
            && data().speedKmh >= 0
            && data().speedKmh <= 500
            // Kurs unbekannt (Stillstand, Gerät ohne Kompass) wird als null
            // gespeichert, siehe LivePosition in src/types.ts.
            && (data().headingDeg == null
                || (data().headingDeg is number && data().headingDeg >= 0 && data().headingDeg <= 360));
        }

        allow read: if ownsTrip(tripId);
        allow create: if ownsTrip(tripId) && isTrackPoint();
        // Trackpunkte werden nur angehängt, nie nachträglich verändert.
        allow update: if false;
        allow delete: if isAdminSession(tripId);
      }

      // --- Logbuch -------------------------------------------------------
      match /events/{eventId} {
        function isLogEvent() {
          return fieldsAre(['timestamp', 'author', 'type', 'title', 'lat', 'lng'], ['note', 'deletedAt'])
            && isEpochMillis('timestamp')
            && isText('author', 60)
            && isText('type', 40)
            && isText('title', 120)
            && isOptionalText('note', 2000)
            && isOptionalEpochMillis('deletedAt')
            && isLatitude('lat')
            && isLongitude('lng');
        }

        allow read: if ownsTrip(tripId);
        // Der Papierkorb (deletedAt) ist der Weg für die Crew; endgültig
        // entfernen darf nur der Admin-Zugang.
        allow create, update: if ownsTrip(tripId) && isLogEvent();
        allow delete: if isAdminSession(tripId);
      }

      // --- Bordkasse -----------------------------------------------------
      match /expenses/{expenseId} {
        function isExpense() {
          return fieldsAre(['timestamp', 'author', 'paidBy', 'title', 'amountEuro', 'category'], ['deletedAt'])
            && isOptionalEpochMillis('deletedAt')
            && isEpochMillis('timestamp')
            && isText('author', 60)
            && isText('paidBy', 60)
            && isText('title', 120)
            && data().amountEuro is number
            && data().amountEuro >= 0
            && data().amountEuro <= 1000000
            && isText('category', 40);
        }

        allow read: if ownsTrip(tripId);
        allow create, update: if ownsTrip(tripId) && isExpense();
        allow delete: if isAdminSession(tripId);
      }

      // --- Kombüse: Gerichte -----------------------------------------------
      // Zutaten sind ein eingebettetes Array (siehe src/types.ts, Ingredient) –
      // Firestore-Regeln können den Inhalt eines Array-of-Maps nicht tief je
      // Element validieren, deshalb bleibt es bei Listenart und -länge. Das
      // ist konsistent mit dem übrigen Vertrauensmodell dieser Datei: Wer das
      // Roadtrip-Passwort hat, ist vertraute Crew.
      match /dishes/{dishId} {
        function isDish() {
          return fieldsAre(['name', 'mealType', 'ingredients', 'author', 'timestamp'], ['note', 'deletedAt'])
            && isText('name', 120)
            && isMealType()
            && data().ingredients is list
            && data().ingredients.size() <= 30
            && isText('author', 60)
            && isEpochMillis('timestamp')
            && isOptionalText('note', 500)
            && isOptionalEpochMillis('deletedAt');
        }

        allow read: if ownsTrip(tripId);
        allow create, update: if ownsTrip(tripId) && isDish();
        allow delete: if isAdminSession(tripId);
      }

      // --- Kombüse: Speiseplan ----------------------------------------------
      // Ordnet ein Gericht einem Kalendertag und einer Mahlzeit zu. Mehrere
      // Einträge pro Tag+Mahlzeit sind erlaubt (mehrere Optionen zur Auswahl).
      match /mealPlanEntries/{entryId} {
        function isMealPlanEntry() {
          return fieldsAre(['date', 'mealType', 'dishId', 'author', 'timestamp'], ['deletedAt'])
            && isDateString('date')
            && isMealType()
            && isText('dishId', 64)
            && isText('author', 60)
            && isEpochMillis('timestamp')
            && isOptionalEpochMillis('deletedAt');
        }

        allow read: if ownsTrip(tripId);
        allow create, update: if ownsTrip(tripId) && isMealPlanEntry();
        allow delete: if isAdminSession(tripId);
      }

      // --- Kombüse: Lager ----------------------------------------------------
      // Die Menge wird laufend angepasst (siehe src/pages/kombuese/Inventory.tsx) –
      // das ist ein gewöhnliches update, keine Sonderregel nötig.
      match /inventory/{itemId} {
        function isInventoryItem() {
          return fieldsAre(['name', 'quantity', 'unit', 'location', 'author', 'timestamp'], ['deletedAt'])
            && isText('name', 80)
            && isQuantity('quantity')
            && isText('unit', 20)
            && isText('location', 60)
            && isText('author', 60)
            && isEpochMillis('timestamp')
            && isOptionalEpochMillis('deletedAt');
        }

        allow read: if ownsTrip(tripId);
        allow create, update: if ownsTrip(tripId) && isInventoryItem();
        allow delete: if isAdminSession(tripId);
      }

      // --- Kombüse: Einkaufsliste (manuelle Posten) ---------------------------
      // Posten ohne Bezug zu einem Rezept, z.B. Gas oder Müllbeutel – der
      // Abhak-Status liegt hier direkt am Dokument, anders als bei den aus dem
      // Speiseplan berechneten Zeilen (siehe shoppingListChecks unten).
      match /shoppingListExtras/{itemId} {
        function isShoppingListExtra() {
          return fieldsAre(['name', 'quantity', 'unit', 'checked', 'author', 'timestamp'], ['deletedAt'])
            && isText('name', 80)
            && isQuantity('quantity')
            && isText('unit', 20)
            && data().checked is bool
            && isText('author', 60)
            && isEpochMillis('timestamp')
            && isOptionalEpochMillis('deletedAt');
        }

        allow read: if ownsTrip(tripId);
        allow create, update: if ownsTrip(tripId) && isShoppingListExtra();
        allow delete: if isAdminSession(tripId);
      }

      // --- Kombüse: Einkaufsliste (Abhaken berechneter Posten) ----------------
      // Für aus dem Speiseplan berechnete Zeilen (siehe src/lib/shoppingList.ts)
      // gibt es kein eigenes Dokument – der Abhak-Status liegt unter einem aus
      // Name+Einheit normalisierten Schlüssel. Rein reversibles Abhaken, daher
      // ohne Admin-Schranke; kein delete, verwaiste Einträge für nicht mehr
      // benötigte Zutaten sind harmlos und werden nicht aufgeräumt.
      match /shoppingListChecks/{checkKey} {
        function isShoppingListCheck() {
          return fieldsAre(['checked', 'checkedBy', 'checkedAt'], [])
            && data().checked is bool
            && isText('checkedBy', 60)
            && isEpochMillis('checkedAt');
        }

        allow read: if ownsTrip(tripId);
        allow create, update: if ownsTrip(tripId) && isShoppingListCheck();
      }

      // --- Roadtrip-weite Einstellungen ------------------------------------
      // Genau zwei Dokumente: "general" (Crew-Liste + Rollen) und "quicklogs"
      // (Schnell-Log-Kategorien), siehe src/hooks/useSettings.ts.
      match /settings/{docId} {
        // Rollenzuordnung ist optional (siehe src/lib/permissions.ts):
        // Solange niemand explizit eine Rolle vergeben hat, fehlt das Feld
        // ganz. Wer/was das im Client wie "Owner darf verwalten" durchsetzt,
        // ist UI-Konvention, keine serverseitige Autorisierung – dafür fehlt
        // dem Roadtrip-weiten Auth-User die nötige Einzelidentität pro
        // Crewmitglied (siehe Kommentar am Dateianfang). Geprüft wird hier
        // nur die Form: eine Map von Name auf einen der drei bekannten Werte.
        function isValidRolesMap() {
          return !('roles' in data())
            || (data().roles is map
                && data().roles.size() <= 50
                && data().roles.values().hasOnly(['owner', 'member', 'readonly']));
        }

        function isSettingsDoc() {
          return (docId == 'general'
                  && fieldsAre(['users'], ['roles', 'startDate', 'endDate'])
                  && data().users is list
                  && data().users.size() <= 50
                  && isValidRolesMap()
                  // Reisezeitraum, gebraucht vom Kombüse-Speiseplan und der
                  // Tagesanzeige im Cockpit. Liegt hier statt auf
                  // roadtrips/{tripId}, weil dieses Dokument laut Regel weiter
                  // unten nach dem Anlegen unveränderlich ist.
                  && isOptionalDateString('startDate')
                  && isOptionalDateString('endDate'))
              || (docId == 'quicklogs'
                  && fieldsAre(['items'], [])
                  && data().items is list
                  && data().items.size() <= 50);
        }

        // Beitreten darf jedes Gerät der Crew: Namen zur Liste hinzufügen,
        // ohne jemanden zu entfernen und ohne Rollen anzufassen (siehe
        // CrewGate in src/App.tsx). Wer entfernt oder Rollen vergibt, braucht
        // den Admin-Zugang – sonst könnte sich jedes Crewmitglied selbst zum
        // Owner machen und die Rollen wären reine Dekoration.
        function isJoinOnly() {
          return docId == 'general'
            && data().users.hasAll(resource.data.users)
            && data().get('roles', {}) == resource.data.get('roles', {});
        }

        allow read: if ownsTrip(tripId);
        // Das erste Crewmitglied legt das Dokument an und wird dabei Owner –
        // zu dem Zeitpunkt gibt es noch niemanden, der das absegnen könnte.
        allow create: if ownsTrip(tripId) && isSettingsDoc();
        allow update: if ownsTrip(tripId)
          && isSettingsDoc()
          && (isAdminSession(tripId) || docId == 'quicklogs' || isJoinOnly());
        allow delete: if false;
      }

      // --- Fehlerprotokoll -------------------------------------------------
      // Von src/lib/errorLog.ts befüllt, damit Abstürze auf den Geräten der
      // Crew nachvollziehbar sind. Nur anhängen, nie ändern.
      match /errors/{errorId} {
        function isErrorEntry() {
          return fieldsAre(['timestamp', 'message'],
                           ['stack', 'context', 'author', 'appVersion', 'userAgent', 'url'])
            && isEpochMillis('timestamp')
            && isText('message', 1000)
            && isOptionalText('stack', 4000)
            && isOptionalText('context', 200)
            && isOptionalText('author', 60)
            && isOptionalText('appVersion', 40)
            && isOptionalText('userAgent', 500)
            && isOptionalText('url', 500);
        }

        allow read: if ownsTrip(tripId);
        allow create: if ownsTrip(tripId) && isErrorEntry();
        allow update: if false;
        allow delete: if isAdminSession(tripId);
      }
    }

    // Alles außerhalb der oben aufgeführten Pfade ist gesperrt – Firestore
    // verweigert ohne passende allow-Regel ohnehin jeden Zugriff. Das gilt
    // insbesondere für die alten, nicht mehr genutzten Top-Level-Collections
    // track/events/expenses/settings.
  }
}
