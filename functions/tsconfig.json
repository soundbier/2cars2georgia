{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  // Die Tests der reinen Logik laufen im vitest des Hauptprojekts mit und
  // gehören nicht in das Deploy-Bundle.
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
