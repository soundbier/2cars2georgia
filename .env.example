# Firebase-Konfiguration der App. Für die lokale Entwicklung als .env
# kopieren und mit den Werten aus der Firebase Console füllen
# (Projekteinstellungen → Meine Apps → Web-App → SDK-Konfiguration).
#
# Diese Werte sind keine Geheimnisse: Vite backt sie in das ausgelieferte
# JavaScript ein, jeder Besucher kann sie auslesen. Der eigentliche Schutz
# liegt in firestore.rules und in der Anmeldung – nicht in dieser Datei.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: Sentry-DSN für Crash-/Fehler-Monitoring in Produktion.
# Kostenloses Projekt unter https://sentry.io anlegen (Plattform "React"),
# DSN aus Project Settings → Client Keys (DSN) hier eintragen. Leer lassen
# deaktiviert Sentry komplett – dann läuft die App wie zuvor ohne Monitoring.
# Auch dieser Wert ist kein Geheimnis: Ein DSN erlaubt nur das Einsenden von
# Fehlerberichten, kein Lesezugriff auf das Sentry-Projekt.
VITE_SENTRY_DSN=

# Pflicht für jeden Produktions-Build: reCAPTCHA-v3-Site-Key für Firebase
# App Check (Brute-Force-/Bot-Schutz auf Auth und Firestore). Firebase
# Console → App Check → App registrieren → Anbieter reCAPTCHA v3 → Site-Key
# hierher kopieren. Fehlt er, bricht `npm run build` ab – ein Build ohne
# Bot-Schutz soll nicht wie ein normaler Build aussehen (siehe README).
# Für die lokale Entwicklung darf er leer bleiben.
VITE_RECAPTCHA_SITE_KEY=
