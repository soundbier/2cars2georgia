# Firebase-Konfiguration der App. Für die lokale Entwicklung als .env
# kopieren und mit den Werten aus der Firebase Console füllen
# (Projekteinstellungen → Meine Apps → Web-App → SDK-Konfiguration).
#
# Diese Werte sind keine Geheimnisse: Vite backt sie in das ausgelieferte
# JavaScript ein, jeder Besucher kann sie auslesen. Der eigentliche Schutz
# liegt in firestore.rules und im Roadtrip-Passwort – nicht in dieser Datei.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
